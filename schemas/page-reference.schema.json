{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagina.dev/schemas/page-reference.schema.json",
  "title": "Pagina Page Catalog",
  "type": "object",
  "required": [
    "version",
    "pages"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.7.0"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "family",
          "surfaces",
          "product_contexts",
          "primary_function",
          "secondary_functions",
          "component_recommendations",
          "status",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "product_contexts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "archetype",
                "relation"
              ],
              "properties": {
                "archetype": {
                  "type": "string"
                },
                "relation": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "component_recommendations": {
            "type": "object",
            "required": [
              "core",
              "common",
              "conditional",
              "discouraged"
            ],
            "properties": {
              "core": {
                "$ref": "#/$defs/componentIds"
              },
              "common": {
                "$ref": "#/$defs/componentIds"
              },
              "conditional": {
                "$ref": "#/$defs/componentIds"
              },
              "discouraged": {
                "$ref": "#/$defs/componentIds"
              }
            },
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "planned",
              "draft",
              "available"
            ]
          },
          "reference": {
            "type": "string",
            "pattern": "\\.md$"
          },
          "primary_function": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "secondary_functions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "componentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "additionalProperties": false
}
